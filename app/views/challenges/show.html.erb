<%= turbo_stream_from @challenge %>

<header class="topbar">
  <%= link_to "‹ salas", root_path %>
</header>

<div class="room-header">
  <% percent = (@challenge.current_day * 100.0 / @challenge.days).round %>
  <div class="ring" style="background: conic-gradient(var(--olive) 0% <%= percent %>%, var(--track) <%= percent %>% 100%);">
    <div class="ring__center">
      <span class="ring__day"><%= @challenge.current_day %></span>
      <span class="ring__total">de <%= @challenge.days %></span>
    </div>
  </div>
  <div>
    <h1><%= @challenge.name %></h1>
    <p class="muted">
      <% if @challenge.upcoming? %>
        <%= @challenge.days %> dias, a partir de <%= @challenge.starts_on.strftime("%d/%m") %>
      <% elsif @challenge.finished? %>
        encerrado — <%= @challenge.days %> dias
      <% else %>
        dia <%= @challenge.current_day %> de <%= @challenge.days %>
      <% end %>
    </p>
  </div>
</div>

<%= render "room", challenge: @challenge %>

<% if @challenge.running? || @challenge.grace_day? %>
  <footer class="checkin-bar">
    <% if @challenge.running? %>
      <% if todays = @participant.checkin_for(@challenge.today) %>
        <%= button_to "Feito hoje ✓ · desfazer", checkin_path(todays), method: :delete, class: "button button--done" %>
      <% else %>
        <%= button_to "Fiz hoje ✓", checkins_path, params: { challenge_id: @challenge.id }, class: "button" %>
      <% end %>
    <% end %>

    <% if @challenge.today > @challenge.starts_on && @participant.checkin_for(@challenge.today - 1).nil? %>
      <%= button_to "esqueci ontem — marcar", checkins_path, params: { challenge_id: @challenge.id, date: "yesterday" }, class: "link" %>
    <% end %>
  </footer>
<% end %>

<section class="invite">
  <h2>Chama mais gente</h2>
  <p>Manda esse link pra quem vai encarar junto:</p>
  <p><code><%= join_url(@challenge.token) %></code></p>
</section>
