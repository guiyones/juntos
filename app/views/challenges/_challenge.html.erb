<%# locals: (challenge:) %>
<li class="challenge-card <%= "is-finished" if challenge.finished? %>">
  <%= link_to challenge do %>
    <strong><%= challenge.name %></strong>
    <span>
      <% if challenge.upcoming? %>
        começa <%= challenge.starts_on.strftime("%d/%m") %>
      <% elsif challenge.finished? %>
        encerrado · <%= challenge.days %> dias
      <% else %>
        dia <%= challenge.current_day %> de <%= challenge.days %>
      <% end %>
    </span>
    <% if challenge.running? %>
      <span class="bar"><i style="width: <%= (challenge.current_day * 100.0 / challenge.days).round %>%"></i></span>
    <% end %>
  <% end %>
</li>
