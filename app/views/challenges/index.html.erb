<header class="topbar">
  <h1 class="wordmark">juntos</h1>
  <nav>
    <% if signed_in? %>
      <%= button_to "Sair", session_path, method: :delete, class: "link" %>
    <% end %>
  </nav>
</header>

<% if @active.none? && @finished.none? %>
  <section class="empty">
    <h2>Desafios são melhores em companhia.</h2>
    <p>Crie um desafio — dormir cedo por 21 dias, uma novena de 40 dias, o que for — e mande o link pra quem vai encarar com você. Cada um marca o seu dia; todo mundo vê que ninguém está sozinho.</p>
    <%= link_to "Criar um desafio", new_challenge_path, class: "button" %>
  </section>
<% else %>
  <section class="greeting">
    <h1><%= greeting %><%= ", #{@greeting_name}" if @greeting_name %></h1>
    <% if @pending_today == 0 && @active.any?(&:running?) %>
      <p>Tudo marcado por hoje. ✓</p>
    <% elsif @pending_today == 1 %>
      <p>Falta 1 check-in hoje.</p>
    <% elsif @pending_today > 1 %>
      <p>Faltam <%= @pending_today %> check-ins hoje.</p>
    <% end %>
  </section>

  <ul class="challenges"><%= render @active %></ul>

  <% if @finished.any? %>
    <details class="finished">
      <summary>ver encerrados (<%= @finished.size %>)</summary>
      <ul class="challenges"><%= render @finished %></ul>
    </details>
  <% end %>

  <%= link_to "+", new_challenge_path, class: "fab", title: "Novo desafio", "aria-label": "Novo desafio" %>
<% end %>
